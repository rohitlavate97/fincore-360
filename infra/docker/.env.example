# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#
# Every variable the stack needs is listed here. A missing required secret must
# make the application FAIL TO START rather than fall back to a default: a
# fallback that works is worse than a crash, because nobody notices it ran
# against the wrong database (FM-INFRA-003).

# ── PostgreSQL ───────────────────────────────────────────────────────────
DB_NAME=fincore
DB_USERNAME=fincore
DB_PASSWORD=change-me-locally
DB_PORT=5432
DB_POOL_MAX=10

# ── Application & Web ────────────────────────────────────────────────────
APP_PORT=8080
APP_ENV=development
APP_VERSION=0.1.0-SNAPSHOT
WEB_PORT=3000

# Structured logging: leave empty for human-readable console output,
# or set to one of: ecs | logstash | gelf
LOG_FORMAT=
LOG_LEVEL_FINCORE=INFO

# ── Observability (Prometheus & Grafana) ──────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
